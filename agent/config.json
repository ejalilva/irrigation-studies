{
  "_help": "Settings for agent/find_papers.py. Edit the search phrases to change what the agent looks for.",
  "site_url": "https://ejalilva.github.io/irrigation-studies/",
  "lookback_days": 60,
  "max_pages_per_query": 5,
  "max_new_per_run": 20,
  "queries": [
    "irrigation satellite soil moisture",
    "irrigation water use remote sensing",
    "irrigation quantification satellite",
    "irrigated area mapping satellite",
    "irrigation timing detection Sentinel-1",
    "irrigation evapotranspiration thermal remote sensing",
    "irrigation land surface model",
    "irrigation data assimilation",
    "irrigation Earth system model"
  ],
  "must_mention_any": [
    "satellite", "remote sensing", "remotely sensed", "earth observation",
    "smap", "smos", "ascat", "amsr", "sentinel", "landsat", "modis", "ecostress", "grace",
    "land surface model", "earth system model", "hydrological model", "hydrologic model",
    "data assimilation", "noah", "community land model", "lpjml", "vic model"
  ],
  "claude_model": "claude-haiku-5-5",
  "claude_seconds_between_calls": 1.5,
  "find_data_links": true,
  "data_links_per_run": 80,
  "data_links_recheck_days": 180
}
